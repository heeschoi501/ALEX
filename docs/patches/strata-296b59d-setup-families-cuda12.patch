+def engine_families(eng: Path, lib_dirs=None) -> set:
     """The model families an engine runs (`strata --families`; an engine from before it: Flash-Next's only)."""
+    # The probe needs the same runtime libraries as the server. In particular the CUDA 12 wheels are not
+    # on Windows' global PATH; without them a supported Qwen engine exits before it can print its families.
+    env = os.environ.copy()
+    if lib_dirs:
+        key = "PATH" if WIN else "LD_LIBRARY_PATH"
+        env[key] = os.pathsep.join([str(p) for p in lib_dirs] + ([env[key]] if env.get(key) else []))
     try:
-        text = subprocess.run([str(eng / EXE), "--families"], capture_output=True, text=True, timeout=60).stdout
+        text = subprocess.run([str(eng / EXE), "--families"], capture_output=True, text=True, timeout=60, env=env).stdout
     except (OSError, subprocess.SubprocessError):
         return {"qwen4exp"}
     names = set(text.split())
