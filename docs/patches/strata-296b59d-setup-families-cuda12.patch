+class EngineFamilyProbe(unittest.TestCase):
+    def test_runtime_libraries_reach_the_probe_without_changing_parent_environment(self):
+        for windows, key in ((True, "PATH"), (False, "LD_LIBRARY_PATH")):
+            with self.subTest(windows=windows), mock.patch.object(setup, "WIN", windows), \
+                 mock.patch.dict(setup.os.environ, {key: "existing"}), \
+                 mock.patch.object(setup.subprocess, "run", return_value=mock.Mock(stdout="qwen4exp qwen35moe")) as run:
+                self.assertIn("qwen35moe", setup.engine_families(Path("engine-cuda12"), ["cublas", "runtime"]))
+                self.assertEqual(run.call_args.kwargs["env"][key], setup.os.pathsep.join(["cublas", "runtime", "existing"]))
+                self.assertEqual(setup.os.environ[key], "existing")
+
+    def test_old_engine_fallback_survives_a_failed_probe(self):
+        with mock.patch.object(setup.subprocess, "run", side_effect=OSError("old engine")):
+            self.assertEqual(setup.engine_families(Path("engine")), {"qwen4exp"})
+
